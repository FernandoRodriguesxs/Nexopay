# ─────────────────────────────────────────────────────────────
# NexoPay — variáveis de ambiente (desenvolvimento local)
# Copie para .env na raiz:  cp .env.example .env
# Nunca versione o .env. Nunca coloque secrets reais aqui.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Infra local (docker compose) ─────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://nexopay:nexopay@localhost:5432/nexopay?schema=public
TEST_DATABASE_URL=postgresql://nexopay:nexopay@localhost:5432/nexopay_test?schema=public
REDIS_URL=redis://localhost:6379

# ── API (apps/api) ───────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Origem do dashboard (CORS com credenciais + checagem CSRF de Origin).
DASHBOARD_ORIGIN=http://localhost:3000
# Pepper do HMAC das API Keys (>= 32 caracteres). Gere com: openssl rand -base64 48
# Trocar o pepper invalida todas as API Keys existentes.
API_KEY_PEPPER=change-me-local-only-pepper-at-least-32-chars

# ── Dashboard (apps/dashboard) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3001

# ── Checkout (apps/checkout) ─────────────────────────────────
# Em produção: https://pay.nexopay.com
